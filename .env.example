# ============================================
# Cradle 环境配置模板
# 复制此文件为 .env 并填写你的实际配置
# ============================================

# --------------------------------------------
# 数据库配置
# --------------------------------------------
# 可选值: mysql | sqlite
DB_TYPE=sqlite

# MySQL配置（当 DB_TYPE=mysql 时使用）
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=cradle

# SQLite配置（当 DB_TYPE=sqlite 时使用）
# 使用相对路径，数据文件将存储在项目目录下
DB_PATH=./data/cradle.db

# --------------------------------------------
# 服务端口配置
# --------------------------------------------
# Gateway Master 端口 (默认 3000)
GATEWAY_PORT=3000

# API Server 端口 (Fastify REST API，默认 5320)
PORT=5320

# --------------------------------------------
# JWT 认证配置
# --------------------------------------------
# 用于签名 JWT 令牌的密钥，生产环境请使用强随机字符串
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# --------------------------------------------
# 工作空间配置
# --------------------------------------------
# 使用相对路径，避免权限问题
WORKSPACE_DIR=./workspace
SKILLS_DIR=./workspace/skills

# --------------------------------------------
# LLM API 密钥配置（可选）
# --------------------------------------------
# 注意：系统优先使用数据库中配置的 LLM Provider + Instance

# --------------------------------------------
# 其他可选配置
# --------------------------------------------
# 日志级别: debug | info | warn | error
# LOG_LEVEL=info

# 是否启用调试模式
# NODE_ENV=development
